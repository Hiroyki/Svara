{
  "name": "svara",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "desktop:next": "cross-env SVARA_TARGET=desktop next build",
    "desktop:dev": "npm run desktop:next && node scripts/prepare-desktop.mjs && electron .desktop-app",
    "desktop:build": "npm run desktop:next && node scripts/prepare-desktop.mjs && electron-builder --win --publish never",
    "android:sync": "cross-env SVARA_TARGET=android next build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "lucide-react": "^1.74.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "youtubei.js": "^18.3.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "description": "An ad-light music player for the music catalogue — web, Windows and Android.",
  "author": "MrColdZs",
  "license": "MIT",
  "build": {
    "appId": "app.svara.music",
    "productName": "Svara",
    "electronVersion": "45.3.4",
    "directories": {
      "app": ".desktop-app",
      "output": "dist",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app-server",
        "filter": [
          "**/*",
          ".next/**/*",
          "!**/*.map"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Svara",
      "runAfterFinish": true,
      "uninstallDisplayName": "Svara ${version}",
      "artifactName": "Svara-Setup-${version}.exe"
    },
    "files": [
      "main.cjs",
      "splash.html",
      "icon.png",
      "package.json"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "asar": false
  }
}
